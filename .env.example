# Host port where the frontend container is exposed (default: 80)
FRONTEND_PORT=80

# Backend API URL:
# - Set to full URL if your backend is hosted separately (e.g. Render / AWS / another server):
VITE_API_BASE_URL=https://tablingtime-backend.onrender.com
# - Or set to empty string "" if using the Nginx reverse-proxy on this VM to proxy /api and /auth to http://backend:3000:
# VITE_API_BASE_URL=

# Base URL path for routing and assets (default "/" for root domain or IP)
VITE_BASE_PATH=/
